# Скопируйте в .env и измените все секреты перед продакшеном

# Обязательно сменить (длинная случайная строка, ≥32 символов)
JWT_SECRET=thegreathike-production-secret-change-me-32b

# Учётная запись администратора при первом запуске
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Ключевая фраза администратора (буквы + цифры, не совпадает с логином и паролем)
ADMIN_RECOVERY_KEY=AdminKey1
# Секрет для входа в раздел админки (капча + этот ключ). Должен совпадать с тем, что вводите в форме.
# После смены: docker compose up -d --build auth-service
ADMIN_SECRET_KEY=change-me-to-a-long-random-admin-secret

# База данных (не оставляйте дефолт thegreathike/thegreathike в проде)
POSTGRES_PASSWORD=thegreathike

# CORS: через запятую, только ваш домен в продакшене
# CORS_ORIGINS=https://your-domain.example,http://localhost:3000

# Часовой пояс для дат визитов (совпадает с браузером пользователя)
APP_TIMEZONE=Europe/Moscow
